{
  "manifest_version": 3,
  "name": "Browser Time - Productivity & Time Tracking",
  "short_name": "Browser Time",
  "version": "1.0.0",
  "description": "Smart browser time-tracking, tab monitoring, and productivity analytics dashboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Browser Time",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle"
  ]
}
